{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["lib", "hooks"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/__tests__/**"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "includeVersion": true,
  "readme": "none",
  "plugin": [],
  "treatWarningsAsErrors": false
}
